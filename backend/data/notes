      "ar": [
      ],
      "amz": [

      ]
    },
    "meta": {
      "fr": [
        ""
      ],
      "en": [
        ""
      ],
      "ar": [
        ""
      ],
      "amz": [
        ""
      ]
    },
    "data": "2025-04-28"
  }



